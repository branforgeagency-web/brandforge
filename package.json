{
  "name": "brandforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"const fs = require('fs'); if (fs.existsSync('.next/BUILD_ID')) fs.rmSync('.next', { recursive: true, force: true });\" && next dev",
    "build": "node -e \"const fs = require('fs'); fs.rmSync('.next', { recursive: true, force: true });\" && next build",
    "start": "next start",
    "lint": "next lint",
    "sync:storage": "node scripts/sync-to-amplify-s3.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "aws-amplify": "^6.22.2",
    "framer-motion": "^13.1.0",
