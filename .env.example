# ==========================================
# BrandForge AWS Amplify & Storage Config
# ==========================================

# AWS Region where your Amplify Storage (S3) bucket is deployed (e.g. ap-south-1, us-east-1)
VITE_AWS_REGION=us-east-1

# S3 Bucket Name provisioned by AWS Amplify Storage
VITE_AWS_STORAGE_BUCKET_NAME=your-amplify-storage-bucket-name

# (Recommended for production performance) CloudFront distribution domain or custom media domain
# e.g. https://d123456abcdef8.cloudfront.net or https://media.brandforgeagency.in
VITE_AWS_CLOUDFRONT_URL=

# Generic Storage Base URL (optional override - if set, used directly as media base URL)
VITE_STORAGE_BASE_URL=

# AWS Cognito Identity Pool ID (required if using Amplify SDK for guest/authenticated S3 access)
# e.g. us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_AWS_IDENTITY_POOL_ID=

# AWS Cognito User Pool (optional, if using authenticated storage)
VITE_AWS_USER_POOLS_ID=
VITE_AWS_USER_POOLS_WEB_CLIENT_ID=

# ==========================================
# S3 Sync Script Configuration (CLI script only)
# Used by: npm run sync:storage
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-amplify-storage-bucket-name
